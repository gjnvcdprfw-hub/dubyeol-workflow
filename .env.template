# .env.template
# Environment variable template for dubyeol-workflow.
# Copy this file and set your actual values in ~/.zshrc or ~/.zprofile.
# NEVER put real API key values in this file or any tracked file.
#
# Usage:
#   1. Add the variables below to your ~/.zshrc (or ~/.zprofile)
#   2. Set each value to your actual credentials/paths
#   3. Run: source ~/.zshrc

# ── Repository paths ─────────────────────────────────────────────────────────

# Root of the current working repository (auto-detected by scripts; override if needed)
# REPO_ROOT=/path/to/your/project

# Absolute path to the dubyeol-workflow master repository
# Used by sync-to-client.sh to locate the master root when called from outside scripts/
# DUBYEOL_MASTER_ROOT=/path/to/dubyeol-workflow

# Absolute path to the client repository (default client for sync operations)
# Can be overridden per-invocation via CLI argument: ./scripts/sync-to-client.sh <client-path>
# DUBYEOL_CLIENT_ROOT=/path/to/client-project

# Short identifier for the client (used in sync reports and logs)
# CLIENT_NAME=myproject

# ── API keys — set in shell profile, never in any tracked file ───────────────

# OpenAI API key (required for Codex CLI and GPT-based review steps)
# OPENAI_API_KEY=<SET_IN_SHELL_PROFILE>

# Anthropic API key (required for Claude API usage)
# ANTHROPIC_API_KEY=<SET_IN_SHELL_PROFILE>
